@model LogisticsPlatform.API.DTOs.LoginDto
@{
    ViewData["Title"] = "Login - SmartLogistics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 420px; margin: 3rem auto;" class="card">
    <h2 style="margin-top:0; text-align:center; color:#60a5fa;">Sign In</h2>
    <p style="color:#94a3b8; text-align:center; font-size:0.9rem;">Enterprise Supply Chain Intelligence Platform</p>

    <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" style="display:flex; flex-direction:column; gap:1rem; margin-top:1.5rem;">
        <div asp-validation-summary="All" style="color:#f87171; font-size:0.85rem;"></div>

        <div>
            <label style="display:block; margin-bottom:0.3rem;">Username</label>
            <input asp-for="Username" style="width:100%; padding:0.6rem; border-radius:6px; background:#0f172a; color:white; border:1px solid #334155;" required />
        </div>

        <div>
            <label style="display:block; margin-bottom:0.3rem;">Password</label>
            <input asp-for="Password" type="password" style="width:100%; padding:0.6rem; border-radius:6px; background:#0f172a; color:white; border:1px solid #334155;" required />
        </div>

        <button type="submit" class="btn" style="width:100%; margin-top:0.5rem;">Log In</button>
        <p style="text-align:center; font-size:0.85rem; color:#94a3b8;">
            Need an account? <a href="/Account/Register" style="color:#60a5fa;">Register here</a>
        </p>
    </form>
</div>