@model LogisticsPlatform.API.DTOs.RegisterDto
@{
    ViewData["Title"] = "Register User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width: 450px; margin: 2rem auto;" class="card">
    <h2 style="margin-top:0; text-align:center; color:#34d399;">Create Account</h2>

    <form asp-action="Register" method="post" style="display:flex; flex-direction:column; gap:1rem; margin-top:1.5rem;">
        <div asp-validation-summary="All" style="color:#f87171; font-size:0.85rem;"></div>

        <div>
            <label style="display:block; margin-bottom:0.3rem;">Full Name</label>
            <input asp-for="FullName" style="width:100%; padding:0.6rem; border-radius:6px; background:#0f172a; color:white; border:1px solid #334155;" required />
        </div>

        <div>
            <label style="display:block; margin-bottom:0.3rem;">Email Address</label>
            <input asp-for="Email" type="email" style="width:100%; padding:0.6rem; border-radius:6px; background:#0f172a; color:white; border:1px solid #334155;" required />
        </div>

        <div>
            <label style="display:block; margin-bottom:0.3rem;">Username</label>
            <input asp-for="Username" style="width:100%; padding:0.6rem; border-radius:6px; background:#0f172a; color:white; border:1px solid #334155;" required />
        </div>

        <div>
            <label style="display:block; margin-bottom:0.3rem;">Password</label>
            <input asp-for="Password" type="password" style="width:100%; padding:0.6rem; border-radius:6px; background:#0f172a; color:white; border:1px solid #334155;" required />
        </div>

        <button type="submit" class="btn" style="width:100%; background:#059669; margin-top:0.5rem;">Register Account</button>
    </form>
</div>