@{ ViewData["Title"] = "AI Operations Assistant"; }

<h2 class="mb-4"><i class="fa-solid fa-robot text-info me-2"></i>AI Operations Assistant</h2>

<div class="card shadow">
    <div class="card-body d-flex flex-column" style="height: 480px;">
        <div id="chatWindow" class="flex-grow-1 overflow-auto p-3 mb-3 border border-secondary rounded" style="background-color: #0f172a;">
            <div class="p-2 mb-2 rounded bg-secondary text-white" style="max-width: 75%;">
                <strong><i class="fa-solid fa-robot me-1"></i> AI Assistant:</strong> Hello! Ask me anything about stock predictions, vehicle routes, or driver assignments.
            </div>
        </div>
        <div class="input-group">
            <input type="text" id="userInput" class="form-control" placeholder="Type your logistics inquiry..." onkeypress="if(event.key==='Enter') sendMessage()" />
            <button class="btn btn-info text-white" onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i> Send</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function sendMessage() {
            const input = document.getElementById("userInput");
            const chat = document.getElementById("chatWindow");
            if (!input.value.trim()) return;

            const userMsg = input.value;
            chat.innerHTML += `<div class="p-2 mb-2 rounded bg-info text-white ms-auto" style="max-width: 75%;">${userMsg}</div>`;
            input.value = "";
            chat.scrollTop = chat.scrollHeight;

            setTimeout(() => {
                chat.innerHTML += `<div class="p-2 mb-2 rounded bg-secondary text-white" style="max-width: 75%;"><strong><i class="fa-solid fa-robot me-1"></i> AI Assistant:</strong> Query analyzed against logistics database. Operational parameters are within expected thresholds.</div>`;
                chat.scrollTop = chat.scrollHeight;
            }, 800);
        }
    </script>
}