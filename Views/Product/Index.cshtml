@model IEnumerable<LogisticsPlatform.API.Models.Product>
@{ ViewData["Title"] = "Products Catalog"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-box text-info me-2"></i>Product Catalog & Stock</h2>
    <a href="/Products/Create" class="btn btn-info text-white"><i class="fa-solid fa-plus me-1"></i> Add Product</a>
</div>

<div class="card shadow">
    <div class="card-body p-0">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr class="table-active">
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td><code>@item.SKU</code></td>
                            <td>@item.Category?.Name</td>
                            <td>$@item.Price.ToString("F2")</td>
                            <td>@item.StockQuantity</td>
                            <td>
                                @if (item.StockQuantity < 10)
                                { <span class="badge bg-danger">Low Stock</span> }
                                else
                                { <span class="badge bg-success">In Stock</span> }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No products found in database context.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>